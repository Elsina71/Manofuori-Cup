rules_version = '2';

// Tutti possono leggere tornei, squadre (senza rose), calendari e risultati.
// Solo gli utenti presenti nella raccolta "admins" (ID documento = UID) possono modificare.
// La raccolta "admins" si gestisce solo dalla console Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    // ADMIN GENERALE: accesso e scrittura su tutto. Sono gli account con queste email (confermate),
    // l'account principale e gli eventuali altri inseriti nella raccolta "admins".
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid in ['Q0EvxfRr7wfZqvNeqLnRcSMN8Tv2']
            || (request.auth.token.email is string && request.auth.token.email_verified == true
                && request.auth.token.email.lower() in ['pierpaolomurgioni@gmail.com'])
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // Ruoli assegnati dagli admin generali: roles/{uid} = { tour: admin tornei, cash: cassa, captain: capitano }.
    function hasRole(r) {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get(r, false) == true;
    }
    // ADMIN TORNEI: tornei a squadre, squadre e livelli, referti e scorer. Nient'altro.
    function isTourAdmin() { return isAdmin() || hasRole('tour'); }
    // CASSA: registra incassi ed emette ricevute.
    function isCash() { return isAdmin() || hasRole('cash'); }

    match /data/{docId} {
      allow read: if true;
      allow write: if (isAdmin() && docId in ['settings', 'tour', 'editorial1', 'editorial2'])
        || (isTourAdmin() && docId == 'tour');
    }

    match /roles/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, write: if isAdmin();
    }

    // ---------- referto elettronico (E-scoresheet) ----------
    // Account dei campi: scorers/{email}, gestiti dall'admin. Possono solo compilare i referti.
    function isScorer() {
      return request.auth != null && request.auth.token.email is string
        && exists(/databases/$(database)/documents/scorers/$(request.auth.token.email.lower()));
    }
    function isStaff() { return isTourAdmin() || isScorer(); }
    // Account del campo legato a un torneo (campo "tid"): scrive solo in quel torneo. Senza "tid": tutti i tornei.
    function scorerFor(tid) {
      return isScorer()
        && get(/databases/$(database)/documents/scorers/$(request.auth.token.email.lower())).data.get('tid', '') in ['', tid];
    }

    // Il refertista scrive solo i campi previsti, non omologa e non cambia gara né squadre.
    function scorerSets(fields) {
      return request.resource.data.keys().hasOnly(fields)
        && request.resource.data.status in ['ready', 'live', 'finished']
        && request.resource.data.get('approvedAt', null) == null;
    }
    function sameMatch() {
      return request.resource.data.tid == resource.data.tid && request.resource.data.key == resource.data.key
        && request.resource.data.a == resource.data.a && request.resource.data.b == resource.data.b;
    }
    function rightId(id) { return id == request.resource.data.tid + '_' + request.resource.data.key; }

    match /scorers/{email} {
      allow get: if isTourAdmin() || (request.auth != null && request.auth.token.email is string && request.auth.token.email.lower() == email);
      allow list, write: if isTourAdmin();
    }

    // referti/{torneo}_{gara}: un documento per gara con tutti i dati del referto (firme comprese).
    match /referti/{id} {
      allow read: if isStaff();
      allow create: if isTourAdmin() || (scorerFor(request.resource.data.tid) && rightId(id) && scorerSets(['tid', 'key', 'a', 'b', 'court', 'info', 'status', 'sets', 'setsWon', 'cur', 'serving', 'winner', 'outcome', 'json', 'createdBy', 'createdAt', 'updated', 'updatedBy', 'approvedAt', 'closedAt']));
      allow update: if isTourAdmin() || (scorerFor(resource.data.tid) && resource.data.status in ['ready', 'live', 'finished'] && sameMatch()
        && scorerSets(['tid', 'key', 'a', 'b', 'court', 'info', 'status', 'sets', 'setsWon', 'cur', 'serving', 'winner', 'outcome', 'json', 'createdBy', 'createdAt', 'updated', 'updatedBy', 'approvedAt', 'closedAt']));
      allow delete: if isTourAdmin();
    }

    // refertiPdf/{torneo}_{gara}[_n]: archivio dei PDF (anche in più parti se il file è grande).
    match /refertiPdf/{id} {
      allow read: if isStaff();
      allow create, update: if (isTourAdmin() || scorerFor(request.resource.data.tid))
        && request.resource.data.keys().hasOnly(['tid', 'key', 'ref', 'status', 'version', 'name', 'parts', 'part', 'data', 'updated']);
      allow delete: if isTourAdmin();
    }

    // live/{torneo}_{gara}: punteggio in diretta, pubblico (senza dati personali né firme).
    match /live/{id} {
      allow read: if true;
      allow create: if isTourAdmin() || (scorerFor(request.resource.data.tid) && rightId(id) && scorerSets(['tid', 'key', 'a', 'b', 'status', 'sets', 'setsWon', 'cur', 'serving', 'winner', 'outcome', 'updated', 'approvedAt']));
      allow update: if isTourAdmin() || (scorerFor(resource.data.tid) && resource.data.status in ['ready', 'live', 'finished'] && sameMatch()
        && scorerSets(['tid', 'key', 'a', 'b', 'status', 'sets', 'setsWon', 'cur', 'serving', 'winner', 'outcome', 'updated', 'approvedAt']));
      allow delete: if isTourAdmin();
    }

    // ---------- utenti registrati, iscrizioni, messaggi ----------
    function isMember() {
      return request.auth != null && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    // Email dell'account confermata (link ricevuto dopo la registrazione): serve per iscriversi.
    // ... oppure confermato a mano dall'admin (verified/{uid}), per chi non riceve l'email o è registrato dall'admin.
    function verified() {
      return request.auth != null && (request.auth.token.email_verified == true
        || exists(/databases/$(database)/documents/verified/$(request.auth.uid)));
    }
    // Lista nera decisa dall'admin: bans/{uid} con tour (iscrizioni ai tornei).
    function banned(uid, what) {
      return exists(/databases/$(database)/documents/bans/$(uid))
        && get(/databases/$(database)/documents/bans/$(uid)).data.get(what, false) == true;
    }

    // Profilo del giocatore: nome, cognome, sesso. Lo scrive solo il titolare; lo leggono gli utenti collegati.
    match /members/{uid} {
      allow read: if isAdmin() || isTourAdmin() || isCash() || isMember() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['first', 'last', 'gender', 'created', 'privacyAt', 'privacyVer', 'deleteReq'])
        && request.resource.data.first is string && request.resource.data.first.size() > 0 && request.resource.data.first.size() <= 60
        && request.resource.data.last is string && request.resource.data.last.size() > 0 && request.resource.data.last.size() <= 60
        && request.resource.data.gender in ['M', 'F'];
      allow delete: if isAdmin();
      // l'admin registra direttamente un utente
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['first', 'last', 'gender', 'created', 'privacyAt', 'privacyVer', 'deleteReq'])
        && request.resource.data.gender in ['M', 'F'];
    }

    // Conferma a mano dell'utente da parte dell'admin (vale come email confermata).
    match /verified/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ---------- tornei a squadre (pallavolo) ----------
    // vtours/{id}: torneo (livello, gironi, playoff): pubblico, lo scrive l'admin tornei.
    // vmatches/{torneo_gara}: gara (squadre, data, ora, palestra, set): pubblica. L'admin tornei scrive tutto;
    //   lo scorer (account del campo, legato al torneo o a tutti) inserisce solo i set, il golden set e lo stato.
    match /vtours/{id} {
      allow read: if true;
      allow write: if isTourAdmin();
    }
    match /vmatches/{id} {
      allow read: if true;
      allow write: if isTourAdmin();
      allow update: if scorerFor(resource.data.tid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sets', 'status', 'golden', 'by', 'updated'])
        && request.resource.data.status in ['sched', 'done']
        && request.resource.data.sets is list && request.resource.data.sets.size() <= 5
        && request.resource.data.by == request.auth.token.email.lower();
    }

    // ---------- squadre ----------
    // teams/{id}: pubblico. Il capitano (utente registrato abilitato dall'admin: roles.captain; email confermata,
    //   non in lista nera) la crea in attesa
    //   (status "pending"); può cambiare nome e tipo sempre, il livello solo finché è in attesa; può ritirarla solo
    //   in attesa. L'ammissione (status "ok") e tutto il resto li decide l'admin tornei.
    // rosters/{id}: rosa (players: cognome, nome, sesso, numero di maglia, account app): la scrivono il capitano e l'admin;
    //   la leggono loro e gli scorer (per il referto). teams.memberUids: account app dei giocatori (vedono le gare della squadra).
    function teamDoc(id) { return /databases/$(database)/documents/teams/$(id); }
    function teamFields(d) {
      return (!('memberUids' in d) || (d.memberUids is list && d.memberUids.size() <= 60))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.level is string && d.level.size() > 0 && d.level.size() <= 40
        && d.kind in ['X', 'M', 'F'];
    }
    match /teams/{id} {
      allow read: if true;
      allow write: if isTourAdmin();
      allow create: if isMember() && verified() && hasRole('captain') && !banned(request.auth.uid, 'tour')
        && request.resource.data.keys().hasOnly(['name', 'level', 'kind', 'captainUid', 'captainName', 'memberUids', 'status', 'created', 'updated'])
        && request.resource.data.captainUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && teamFields(request.resource.data)
        && request.resource.data.captainName is string && request.resource.data.captainName.size() <= 130;
      allow update: if isMember() && resource.data.captainUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'level', 'kind', 'memberUids', 'updated'])
        && (resource.data.status == 'pending' || request.resource.data.level == resource.data.level)
        && teamFields(request.resource.data);
      allow delete: if isMember() && resource.data.captainUid == request.auth.uid && resource.data.status == 'pending';
    }
    match /rosters/{id} {
      allow read: if isTourAdmin() || isScorer() || (request.auth != null && resource.data.captainUid == request.auth.uid);
      allow write: if isTourAdmin();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['captainUid', 'players', 'updated'])
        && request.resource.data.captainUid == request.auth.uid
        && getAfter(teamDoc(id)).data.captainUid == request.auth.uid
        && request.resource.data.players is list && request.resource.data.players.size() <= 40;
      allow delete: if isMember() && resource.data.captainUid == request.auth.uid && !existsAfter(teamDoc(id));
    }

    // Messaggi dell'admin: li legge solo chi è tra i destinatari (o tutti gli utenti registrati se "all").
    match /messages/{id} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid in resource.data.get('to', []))
        || (resource.data.get('all', false) == true && isMember());
      allow write: if isAdmin();
    }

    // Email dell'account: la vedono solo il titolare e l'admin.
    match /accounts/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'verified'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.get('verified', false) == (request.auth.token.email_verified == true);
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['email', 'verified']) && request.resource.data.verified == false;
      allow delete: if isAdmin();   // eliminazione dell'utente (diritto alla cancellazione)
    }

    // Messaggi già letti da ciascun utente.
    match /inbox/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /bans/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ---------- gioco libero ----------
    // freeplay/{id}: sessione creata dall'admin; pubblici solo i contatori m/f dei partecipanti.
    // fpreg/{id_uid}: partecipazione dell'utente registrato (nomi visibili solo all'admin e all'interessato).
    // Contatore e partecipazione cambiano insieme: +1 quando si entra, -1 quando ci si cancella.
    // Iscrizione e cancellazione fino a un'ora prima dell'inizio (startMs).
    function fpr(fid) { return /databases/$(database)/documents/fpreg/$(fid + '_' + request.auth.uid); }
    function fpIn(fid) { return exists(fpr(fid)) && get(fpr(fid)).data.status == 'in'; }
    function fpInAfter(fid) { return existsAfter(fpr(fid)) && getAfter(fpr(fid)).data.status == 'in'; }
    function fpKey(fid) { return getAfter(fpr(fid)).data.gender == 'F' ? 'f' : 'm'; }

    match /freeplay/{fid} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'date', 'from', 'to', 'startMs', 'endMs', 'levels', 'place', 'blocks', 'm', 'f', 'by', 'created'])
        && request.resource.data.startMs is int
        && request.resource.data.m == 0 && request.resource.data.f == 0;
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null && existsAfter(fpr(fid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([fpKey(fid)])
            && ((fpInAfter(fid) && !fpIn(fid) && request.resource.data[fpKey(fid)] == resource.data.get(fpKey(fid), 0) + 1)
                || (!fpInAfter(fid) && fpIn(fid) && request.resource.data[fpKey(fid)] == resource.data.get(fpKey(fid), 0) - 1)));
    }

    match /fpreg/{id} {
      // ognuno legge solo la propria partecipazione (anche prima che esista: l'id finisce con il suo uid)
      allow get: if isAdmin() || (request.auth != null && id.matches('.*_' + request.auth.uid));
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
      allow create, update: if isAdmin() || (isMember() && verified()
        && request.resource.data.keys().hasOnly(['fid', 'uid', 'name', 'gender', 'level', 'status', 'at', 'outAt', 'n', 'bl', 'anon'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.fid + '_' + request.auth.uid
        && request.resource.data.gender == get(/databases/$(database)/documents/members/$(request.auth.uid)).data.gender
        && request.resource.data.status in ['in', 'out']
        && request.resource.data.level in ['none', 'start', 'inter', 'high', 'pro']
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.get('bl', []) is list && request.resource.data.get('bl', []).size() <= 24
        && exists(/databases/$(database)/documents/freeplay/$(request.resource.data.fid))
        // ci si iscrive, ci si cancella e si cambiano i blocchi fino a un'ora prima dell'inizio
        && request.time.toMillis() < get(/databases/$(database)/documents/freeplay/$(request.resource.data.fid)).data.startMs - 3600000
        // sessione a blocchi: chi partecipa sceglie almeno un blocco
        && (request.resource.data.status == 'out' || !get(/databases/$(database)/documents/freeplay/$(request.resource.data.fid)).data.get('blocks', false)
            || request.resource.data.get('bl', []).size() > 0)
        && (
          // entrata o uscita: il contatore pubblico del proprio sesso cambia nello stesso invio
          (getAfter(/databases/$(database)/documents/freeplay/$(request.resource.data.fid)).data[request.resource.data.gender == 'F' ? 'f' : 'm']
             == get(/databases/$(database)/documents/freeplay/$(request.resource.data.fid)).data[request.resource.data.gender == 'F' ? 'f' : 'm']
                + (request.resource.data.status == 'in' ? 1 : -1)
           && (resource == null ? request.resource.data.status == 'in' : resource.data.status != request.resource.data.status)
           // all'uscita sparisce anche la presenza anonima nei blocchi
           && (request.resource.data.status == 'in' || resource.data.get('anon', '') == ''
               || !existsAfter(/databases/$(database)/documents/fpanon/$(resource.data.anon))))
          // cambio dei soli blocchi, restando dentro
          || (resource != null && resource.data.status == 'in' && request.resource.data.status == 'in'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bl']))
        ));
    }

    // fpanon/{id}: presenza anonima nei blocchi (sesso e blocchi, senza nome né uid). Copia esatta della propria
    // partecipazione (fpreg.anon == id): si scrive solo insieme a lei e sparisce quando si esce.
    function fpra(fid) { return getAfter(fpr(fid)).data; }
    match /fpanon/{aid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['fp', 'g', 'bl', 'date'])
        && (resource == null || resource.data.fp == request.resource.data.fp)
        && existsAfter(fpr(request.resource.data.fp))
        && fpra(request.resource.data.fp).get('anon', '') == aid
        && fpra(request.resource.data.fp).status == 'in'
        && fpra(request.resource.data.fp).get('bl', []) == request.resource.data.bl
        && fpra(request.resource.data.fp).gender == request.resource.data.g
        && request.resource.data.date == get(/databases/$(database)/documents/freeplay/$(request.resource.data.fp)).data.date;
      // solo la propria (la partecipazione puntava a questa presenza) e solo uscendo o cambiandola
      allow delete: if isAdmin() || (request.auth != null && exists(fpr(resource.data.fp))
        && get(fpr(resource.data.fp)).data.get('anon', '') == aid
        && (!existsAfter(fpr(resource.data.fp)) || fpra(resource.data.fp).get('anon', '') != aid || fpra(resource.data.fp).status == 'out'));
    }

    // ---------- allenamenti ----------
    // trainings: pubblici (giorno, orari, coach, livello, massimo, luogo); li scrive solo l'admin.
    // coaches/{uid}: coach indicato dall'admin (all = vede tutti gli allenamenti, altrimenti solo i suoi).
    // athletes/{uid}: scheda corsista con dati personali: solo admin e interessato (in lettura).
    // groups/{tid_mese}: nomi del gruppo: admin e coach (tutti o solo i gruppi dei suoi allenamenti).
    // plans/{uid_mese}: piano e prezzo del mese: admin e interessato (in lettura).
    function coachDoc() { return /databases/$(database)/documents/coaches/$(request.auth.uid); }
    function isCoach() { return request.auth != null && exists(coachDoc()); }
    match /trainings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coaches/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, write: if isAdmin();
    }
    match /athletes/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, write: if isAdmin();
    }
    match /groups/{id} {
      allow read: if isAdmin() || (isCoach() && (get(coachDoc()).data.get('all', false) == true || resource.data.coachUid == request.auth.uid));
      allow write: if isAdmin();
    }
    match /plans/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    // packs/{id}: pacchetto di allenamenti (numero, prezzo, usati): admin e interessato (in lettura).
    match /packs/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---------- presenze e spot ----------
    // occ/{tid_data}: pubblico (p presenti, a assenti, s spot confermati, cancelled). Il corsista cambia solo p e a,
    //   e solo insieme alla propria risposta att/{tid_data_uid} (contatori coerenti con il cambio di risposta).
    // att e spots: li leggono l'admin, l'interessato e il coach (tutti o solo i suoi allenamenti, campo coachUid).
    function occP(oid) { return /databases/$(database)/documents/occ/$(oid); }
    function attP(oid) { return /databases/$(database)/documents/att/$(oid + '_' + request.auth.uid); }
    function stBefore(oid) { return exists(attP(oid)) ? get(attP(oid)).data.status : 'none'; }
    function stAfter(oid) { return existsAfter(attP(oid)) ? getAfter(attP(oid)).data.status : 'none'; }
    function cnt(oid, k, st) { return (stAfter(oid) == st ? 1 : 0) - (stBefore(oid) == st ? 1 : 0); }
    function occBefore(oid, k) { return exists(occP(oid)) ? get(occP(oid)).data.get(k, 0) : 0; }
    function occCountsOk(oid) {
      return existsAfter(occP(oid))
        && getAfter(occP(oid)).data.p == occBefore(oid, 'p') + cnt(oid, 'p', 'in')
        && getAfter(occP(oid)).data.a == occBefore(oid, 'a') + cnt(oid, 'a', 'out');
    }
    function seesTraining(d) {
      return request.auth != null && (d.uid == request.auth.uid
        || (isCoach() && (get(coachDoc()).data.get('all', false) == true || d.coachUid == request.auth.uid)));
    }
    function trCoach(tid) { return get(/databases/$(database)/documents/trainings/$(tid)).data.get('coachUid', ''); }
    function inGroup(tid, date, uid) {
      return exists(/databases/$(database)/documents/groups/$(tid + '_' + date[0:7]))
        && get(/databases/$(database)/documents/groups/$(tid + '_' + date[0:7])).data.uids.hasAny([uid]);
    }
    match /occ/{oid} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isMember() && verified()
        && request.resource.data.keys().hasOnly(['tid', 'date', 'p', 'a', 's', 'cancelled'])
        && oid == request.resource.data.tid + '_' + request.resource.data.date
        && request.resource.data.s == 0 && request.resource.data.cancelled == false
        && occCountsOk(oid);
      allow update: if isMember() && verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p', 'a'])
        && occCountsOk(oid);
    }
    // occfree/{tid_data}: posti spot liberi decisi dall'admin (il numero lo vede solo l'admin; in occ resta "open").
    match /occfree/{id} {
      allow read, write: if isAdmin();
    }
    match /att/{id} {
      // la propria anche prima che esista (l'id finisce con il proprio uid)
      allow get: if isAdmin() || (request.auth != null && id.matches('.*_' + request.auth.uid)) || (resource != null && seesTraining(resource.data));
      allow list: if isAdmin() || seesTraining(resource.data);
      allow write: if isAdmin();
      allow create, update: if isMember() && verified()
        && request.resource.data.keys().hasOnly(['tid', 'date', 'uid', 'status', 'at', 'coachUid'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.tid + '_' + request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.status in ['in', 'out']
        && request.resource.data.coachUid == trCoach(request.resource.data.tid)
        && int(request.resource.data.date[8:10]) <= 28   // il 5° giorno del mese è fuori abbonamento (solo spot)
        && inGroup(request.resource.data.tid, request.resource.data.date, request.auth.uid)
        && occCountsOk(request.resource.data.tid + '_' + request.resource.data.date);
    }
    match /spots/{id} {
      // la propria anche prima che esista (l'id finisce con il proprio uid)
      allow get: if isAdmin() || (request.auth != null && id.matches('.*_' + request.auth.uid)) || (resource != null && seesTraining(resource.data));
      allow list: if isAdmin() || seesTraining(resource.data);
      allow write: if isAdmin();
      // candidatura: solo "in attesa", per sé, non per un allenamento del proprio gruppo né annullato
      allow create: if isMember() && verified()
        && request.resource.data.keys().hasOnly(['tid', 'date', 'uid', 'name', 'status', 'at', 'seen', 'coachUid', 'from'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.tid + '_' + request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.seen == false
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.coachUid == trCoach(request.resource.data.tid)
        && (int(request.resource.data.date[8:10]) > 28 || !inGroup(request.resource.data.tid, request.resource.data.date, request.auth.uid))
        && !(exists(occP(request.resource.data.tid + '_' + request.resource.data.date))
             && get(occP(request.resource.data.tid + '_' + request.resource.data.date)).data.get('cancelled', false) == true);
      // l'interessato segna come letto l'esito, o ritira la candidatura ancora in attesa
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid && resource.data.status == 'pending';
    }

    // ---------- ricevute ----------
    // Ricevute: serie Q (quote sociali) e C (commerciali). La cassa le emette; correggerle o annullarle spetta all'admin generale.
    match /receipts/{id} {
      allow read: if isCash() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isCash() && request.resource.data.by == request.auth.uid
        && request.resource.data.series in ['Q', 'C'] && request.resource.data.void == false;
      allow update, delete: if isAdmin();
    }
    // incassi/{id}: registro di tutti gli incassi (anche senza ricevuta) per il resoconto mensile.
    match /incassi/{id} {
      allow read: if isCash();
      allow create: if isCash() && request.resource.data.by == request.auth.uid && request.resource.data.void == false;
      allow update, delete: if isAdmin();
    }
    // tesserati/{uid}: dati per l'intestazione delle ricevute (nome, nascita, residenza, codice fiscale, stagioni),
    // senza certificato né pagamenti. La legge la cassa; la scrive solo l'admin generale (copia delle schede).
    match /tesserati/{uid} {
      allow read: if isCash();
      allow write: if isAdmin();
    }
    match /counters/{id} {
      allow read, write: if isCash();
    }

    // Avvisi per un utente (li scrive l'admin o l'admin tornei, es. gara spostata) o per gli amministratori ("admins").
    match /notices/{id} {
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || (resource.data.to == 'admins' && isAdmin()));
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'text', 'at', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.to is string && (isTourAdmin() || request.resource.data.to == 'admins');
      allow delete: if request.auth != null && (resource.data.to == request.auth.uid || (resource.data.to == 'admins' && isAdmin()));
    }

    // Chi è admin lo decide solo il database: l'app chiede il documento "probe" (o il proprio) e,
    // se la lettura è permessa, l'utente è admin. Nessun UID nel codice pubblico.
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, write: if false;
    }
  }
}
